# Public hostname Traefik should route (no https://).
FORMIO_DOMAIN=forms.example.com

# First-boot admin (only used on an empty Mongo volume).
ROOT_EMAIL=admin@example.com
ROOT_PASSWORD=changeme

# Long random strings: openssl rand -hex 32
JWT_SECRET=
MONGO_SECRET=

# Must match the Docker network your Traefik container is attached to.
# Check with: docker network ls
TRAEFIK_NETWORK=traefik_network

# Typical Traefik v2/v3 HTTPS entrypoint and ACME resolver names.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=myresolver
